{
  "manifest_version": 3,
  "name": "Auto Like & Scroll (TikTok, LinkedIn, Facebook, Instagram, X)",
  "version": "3.2.0",
  "description": "TikTok, LinkedIn, Facebook, Instagram ও X-এ auto like ও auto scroll - site অনুযায়ী নিরাপদ সীমা, ধর্মীয়/রাজনৈতিক filter, minimize অবস্থাতেও চলে।",
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": [
    "https://*.tiktok.com/*",
    "https://*.linkedin.com/*",
    "https://*.facebook.com/*",
    "https://*.instagram.com/*",
    "https://x.com/*",
    "https://*.x.com/*",
    "https://*.twitter.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.tiktok.com/*",
        "https://*.linkedin.com/*",
        "https://*.facebook.com/*",
        "https://*.instagram.com/*",
        "https://x.com/*",
        "https://*.x.com/*",
        "https://*.twitter.com/*"
      ],
      "js": ["config.js", "filter.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Auto Like & Scroll"
  }
}
